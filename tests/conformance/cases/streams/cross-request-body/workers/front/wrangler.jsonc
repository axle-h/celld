// A body one request received, used by a later request (plan 1.26): each
// use is refused with workerd's cross-request error, whether the Worker
// fetched the body, a Dynamic Worker answered with it, or the Dynamic Worker
// fetched it itself. One isolate (the case's env), so the later request sees
// the stashed bodies.
{
  "name": "front",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "services": [{ "binding": "BACK", "service": "back" }],
  "worker_loaders": [{ "binding": "LOADER" }]
}
