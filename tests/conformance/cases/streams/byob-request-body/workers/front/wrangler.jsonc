// BYOB readers on an inbound request body: the step's own body, sent with a
// length and chunked, and back's, which front sends through a service binding
// as a stream of parts or as bytes.
//
// workerd closes the connection after /streamed/cancel, so it is the last
// step, and after /held/cancel and /streamed/reader, which have cases of their
// own: streams/byob-request-body-held-cancel and
// streams/byob-request-body-streamed-reader. See "Steps that close the
// connection" in tests/conformance/README.md.
{
  "name": "front",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "services": [{ "binding": "BACK", "service": "back" }]
}
