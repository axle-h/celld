{
  "upstream": true,
  "env": {
    "CELLD_FETCH_PRIVATE_ALLOW": "127.0.0.1:${UPSTREAM_PORT}",
    "CELLD_MAX_STATELESS_ISOLATES": "1"
  },
  "workers": [
    "app"
  ],
  "steps": [
    {
      "path": "/hold?echo=${UPSTREAM_ECHO_PORT}&http=${UPSTREAM_PORT}"
    },
    {
      "path": "/report"
    }
  ]
}