  "workers": [
    "app"
  ],
  "steps": [
    {
      "path": "/start"
    },
    {
      "rss": "baseline"
    },
    {
      "path": "/ping"
    },
    {
      "cpu": 900,
      "wait": 3000
    },
    {
      "path": "/ping"
    },
    {
      "rss": 128
    }
  ]
}