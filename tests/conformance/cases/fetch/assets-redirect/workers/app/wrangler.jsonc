// Assets with the default html_handling, auto-trailing-slash, which answers a
// request for /about.html with a 307 to /about. run_worker_first sends the
// step's request to the Worker rather than to the assets.
{
  "name": "app",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true }
}
