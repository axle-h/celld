// web_socket_auto_reply_to_close is on from 2026-04-07.
{
  "name": "sockets",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "services": [{ "binding": "BACK", "service": "back" }],
  "durable_objects": { "bindings": [{ "name": "SOCKETS", "class_name": "Sockets" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sockets"] }]
}
