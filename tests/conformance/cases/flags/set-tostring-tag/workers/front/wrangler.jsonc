{
  "name": "front",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "services": [
    {
      "binding": "BEFORE",
      "service": "before"
    },
    {
      "binding": "ENABLE",
      "service": "enable"
    },
    {
      "binding": "DISABLE",
      "service": "disable"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OBJECT",
        "class_name": "ObjectFront"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ObjectFront"
      ]
    }
  ]
}
