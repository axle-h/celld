// web_socket_manual_reply_to_close turns web_socket_auto_reply_to_close off.
{
  "name": "sockets",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["web_socket_manual_reply_to_close"],
  "services": [{ "binding": "BACK", "service": "back" }],
  "durable_objects": { "bindings": [{ "name": "SOCKETS", "class_name": "Sockets" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sockets"] }]
}
