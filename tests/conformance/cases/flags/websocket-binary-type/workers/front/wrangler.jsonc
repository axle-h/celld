{
  "name": "front",
  "main": "index.js",
  "compatibility_date": "2026-03-17",
  "services": [
    { "binding": "BEFORE", "service": "before" },
    { "binding": "ENABLE", "service": "enable" },
    { "binding": "DISABLE", "service": "disable" }
  ]
}
