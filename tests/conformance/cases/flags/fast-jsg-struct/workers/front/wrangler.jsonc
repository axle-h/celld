{
  "name": "front",
  "main": "index.js",
  "compatibility_date": "2025-12-03",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "front-bucket" }],
  "queues": { "producers": [{ "binding": "QUEUE", "queue": "front-queue" }], "consumers": [{ "queue": "front-queue" }] }, "services": [{"binding": "BEFORE", "service": "before"}, {"binding": "DISABLE", "service": "disable"}]
}
