{
  "name": "disable",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "do_not_set_tostring_tag"
  ],
  "services": [
    {
      "binding": "SELF",
      "service": "disable",
      "entrypoint": "Things"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OBJECT",
        "class_name": "ObjectDisable"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ObjectDisable"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "kv-disable"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "r2-disable"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "q-disable"
      }
    ]
  }
}
