{
  "name": "app",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "worker_loaders": [{ "binding": "LOADER" }],
  "services": [
    { "binding": "HOG", "service": "hog" },
    { "binding": "OTHER", "service": "other" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "SUPERVISOR", "class_name": "Supervisor" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Supervisor"] }]
}
