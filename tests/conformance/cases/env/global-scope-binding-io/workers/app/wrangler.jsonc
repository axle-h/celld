{
  "name": "app",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "vars": { "GREETING": "hi" },
  "kv_namespaces": [{ "binding": "KV", "id": "global-scope-binding-io-kv" }],
  "services": [{ "binding": "BACK", "service": "back" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": { "bindings": [{ "name": "OBJ", "class_name": "Obj" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Obj"] }]
}
