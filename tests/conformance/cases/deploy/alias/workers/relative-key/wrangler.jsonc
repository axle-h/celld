// A key that is a relative import path, which no file backs: Wrangler matches
// it as written (bundleBlueprints aliases "./generated/bundled-blueprints.js").
{
  "name": "relative-key",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "alias": { "./generated/module.js": "./lib/module.js" }
}
