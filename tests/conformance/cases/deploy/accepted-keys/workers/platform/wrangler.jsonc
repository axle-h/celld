// Cloudflare platform keys: accepted, with a line for each that asks for
// something celld does not do.
{
  "name": "platform",
  "main": "index.js",
  "compatibility_date": "2026-09-04",
  "account_id": "0123456789abcdef0123456789abcdef",
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "mode": "off" }
}
