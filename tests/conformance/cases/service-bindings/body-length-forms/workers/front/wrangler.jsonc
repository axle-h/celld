// Service bindings to another script and to this one, a Durable Object and a
// Worker Loader.
{
  "name": "front",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "services": [
    { "binding": "BACK", "service": "back" },
    { "binding": "SELF", "service": "front" }
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "OBJ", "class_name": "Obj" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Obj"] }]
}
