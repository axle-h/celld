// An object default export: `ctx.props` reaches its handlers as their third
// argument. It binds itself with and without props.
{
  "name": "plain",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  // Fetcher.scheduled(), for the `scheduled()` steps.
  "compatibility_flags": ["service_binding_extra_handlers"],
  "services": [
    { "binding": "SELF", "service": "plain", "props": { "who": "plain-self" } },
    { "binding": "SELF_NONE", "service": "plain" }
  ]
}
