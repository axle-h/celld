// Receiver rules for a path pipelined through a Durable Object call's result.
{
  "name": "front",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [{ "name": "HOST", "class_name": "Host" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Host"] }]
}
