// RPC across isolates from inside a custom span: to another script's
// entrypoint, to a loaded Worker's entrypoint, and from a Durable Object to
// its facet. Each callee's invocation is a child of the caller's span.
{
  "name": "caller",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "services": [{ "binding": "CALLEE", "service": "callee", "entrypoint": "Work" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": { "bindings": [{ "name": "HOST", "class_name": "Host" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Host"] }]
}
